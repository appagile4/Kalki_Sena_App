# EAS Build ignore configuration
# EAS CLI reads this file INSTEAD of .gitignore when packaging files for build.
# Keeping google-services.json and GoogleService-Info.plist unignored here allows
# EAS CLI to upload them to the cloud build worker from your local machine,
# while .gitignore prevents them from ever being committed to GitHub.

# Dependencies
node_modules/

# Expo cache & outputs
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds & temporary files
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro & Bundler
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# OS files
.DS_Store
Thumbs.db
*.pem

# Local env overrides
.env.local
.env*.local

# TypeScript
*.tsbuildinfo

example/

# Generated native directories (regenerated by prebuild on the build worker)
/ios
/android
