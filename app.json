{
  "expo": {
    "name": "Kalki_Sena_Drive",
    "slug": "Kalki_Sena_Drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kalkisenadrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kalkisenadrive",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["esewa", "esewa"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.kalkisenadrive",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",

      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set your profile picture."
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.284669757325-vr2oqodqkpk2tpb0u46nvb09plbriuq5"
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0266b3"
        }
      ],
      "./plugins/withEsewaIntent.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "67483e0d-ff0b-455d-8801-aa57e65065f2"
      }
    }
  }
}
